{
  "name": "saas-starter-template",
  "version": "1.0.0",
  "description": "Production-ready SaaS application template with authentication, user management, admin panel, and tier system",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run copy-templates && npm run copy-config && npm run copy-locales",
    "copy-templates": "mkdir -p dist/templates && cp src/templates/*.hbs dist/templates/",
    "copy-config": "mkdir -p dist/config && cp src/config/*.json dist/config/",
    "copy-locales": "mkdir -p dist/locales/en dist/locales/de && cp src/locales/en/*.json dist/locales/en/ && cp src/locales/de/*.json dist/locales/de/",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "jest",
    "validate:translations": "tsx scripts/validate-translations.ts"
  },
  "keywords": [
    "saas",
    "template",
    "starter",
    "authentication",
    "admin",
    "typescript",
    "react",
    "express",
    "prisma",
    "jwt",
    "user-management",
    "tier-system"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.4.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "handlebars": "^4.7.8",
    "i18next": "^25.7.1",
    "i18next-fs-backend": "^2.6.1",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/node-cache": "^4.1.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.2",
    "fast-check": "^4.3.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
