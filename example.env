# SaaS Starter Template - Environment Configuration
# Copy this file to .env and customize for your environment
#
# Quick start:
#   cp example.env .env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL database name
POSTGRES_DB=saas_starter

# PostgreSQL username
POSTGRES_USER=saas_starter

# PostgreSQL password
# IMPORTANT: Change this in production! Use a strong, random password.
POSTGRES_PASSWORD=password

# PostgreSQL port (exposed on host)
# Default: 5433
DB_PORT=5433

# Database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development (outside Docker): postgresql://saas_starter:password@localhost:5433/saas_starter
# For Docker containers: postgresql://saas_starter:password@db:5432/saas_starter
DATABASE_URL=postgresql://saas_starter:password@localhost:5433/saas_starter

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================

# Backend API port (exposed on host)
# Default: 3002
API_PORT=3002

# Backend API base URL
# This is used by the frontend to connect to the API
# Development: http://localhost:3002
# Production: https://api.yourdomain.com
API_BASE_URL=http://localhost:3002

# Node environment
# Options: development, production
# - development: Enables debug logging, detailed errors
# - production: Optimized performance, minimal logging
NODE_ENV=production

# Logging level
# Options: debug, info, warn, error
# - debug: All logs including debug messages
# - info: Informational messages and above
# - warn: Warnings and errors only
# - error: Errors only
LOG_LEVEL=info

# API Key for authentication
# REQUIRED: Minimum 32 characters for security
# Generate a secure random key using: openssl rand -hex 32
# Example: 8f7a3b2c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a
# IMPORTANT: Keep this secret! Never commit the actual key to version control.
# This key protects administrative and analytics endpoints.
# Public endpoints (redirects, webhooks) do not require authentication.
API_KEY=your-secure-api-key-here-minimum-32-characters-required

# JWT Secret for authentication tokens
# REQUIRED: Minimum 32 characters for security
# Generate a secure random key using: openssl rand -hex 32
# IMPORTANT: Keep this secret! Never commit the actual key to version control.
# This secret is used to sign and verify JWT tokens for user authentication.
JWT_SECRET=your-secure-jwt-secret-here-minimum-32-characters-required

# JWT Token Expiration
# Default: 24h (24 hours)
# Examples: 1h, 12h, 24h, 7d, 30d
# Shorter expiration is more secure but requires more frequent logins
JWT_EXPIRATION=24h

# =============================================================================
# EMAIL SERVICE CONFIGURATION
# =============================================================================

# SMTP Server Configuration
# Required for sending email confirmations and password reset emails

# SMTP host (e.g., smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST=smtp.example.com

# SMTP port
# Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted - not recommended)
SMTP_PORT=587

# Use secure connection (SSL/TLS)
# Set to 'true' for port 465, 'false' for port 587 with STARTTLS
SMTP_SECURE=false

# SMTP authentication credentials
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# From address for outgoing emails
# This will appear as the sender in user inboxes
SMTP_FROM=noreply@yourdomain.com

# Base URL for email links
# Used to generate confirmation and password reset links
# Development: http://localhost:8081
# Production: https://yourdomain.com
BASE_URL=http://localhost:8081

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend port (exposed on host)
# Default: 8081
FRONTEND_PORT=8081

# =============================================================================
# TASK SCHEDULER CONFIGURATION
# =============================================================================

# Scheduler timezone for cron expressions
# Default: UTC
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
# Using UTC is recommended for consistency across deployments
SCHEDULER_TIMEZONE=UTC

# Scheduler graceful shutdown timeout in milliseconds
# Default: 5000 (5 seconds)
# This controls how long the scheduler waits for running tasks to complete
# before forcing shutdown when the application receives a termination signal
# Examples: 3000 (3 seconds), 5000 (5 seconds), 10000 (10 seconds)
SCHEDULER_SHUTDOWN_TIMEOUT_MS=5000

# Enable task status persistence to database
# Default: true
# When enabled, task execution status (last run, next run, results) is saved to database
# Set to 'false' to disable database persistence (not recommended for production)
SCHEDULER_ENABLE_STATUS_PERSISTENCE=true

# =============================================================================
# TASK EXECUTION HISTORY CONFIGURATION
# =============================================================================

# Enable execution history storage
# Default: true
# When enabled, all task executions are stored with detailed logs
# Set to 'false' to disable history storage (not recommended for production)
TASK_HISTORY_ENABLED=true

# Retention period for execution history in days
# Default: 30
# Records older than this will be deleted by the purge task
# Minimum records per task are always preserved regardless of age
TASK_HISTORY_RETENTION_DAYS=30

# Minimum number of records to keep per task regardless of age
# Default: 10
# Even if records are older than retention period, at least this many
# most recent records per task will be preserved
TASK_HISTORY_MIN_RECORDS=10

# Cron schedule for the history purge task
# Default: "0 2 * * *" (2:00 AM daily)
# Format: standard 5-field cron expression
# Examples: "0 2 * * *" (2 AM daily), "0 3 * * 0" (3 AM Sundays)
TASK_HISTORY_PURGE_SCHEDULE="0 2 * * *"

# Maximum log size per execution in bytes
# Default: 102400 (100KB)
# Logs exceeding this size will be truncated with a warning message
# Examples: 102400 (100KB), 204800 (200KB), 512000 (500KB)
TASK_HISTORY_MAX_LOG_SIZE=102400

# =============================================================================
# NOTES
# =============================================================================
#
# After changing configuration:
# 1. Restart services: docker compose up -d
# 2. Rebuild if needed: docker compose up -d --build
#
# For production deployment:
# 1. Change POSTGRES_PASSWORD to a strong password
# 2. Set API_BASE_URL to your production domain
# 3. Set NODE_ENV to production
# 4. Set LOG_LEVEL to warn or error
# 5. Generate secure API_KEY and JWT_SECRET with: openssl rand -hex 32
# 6. Configure SMTP settings for email functionality
# 7. Set BASE_URL to your production domain
#
# For development:
# 1. Keep default ports to avoid conflicts
# 2. Set NODE_ENV to development for better debugging
# 3. Use a test SMTP service like Mailtrap for email testing
#
# Security recommendations:
# - Never commit .env files to version control
# - Use strong, unique passwords for production
# - Generate a secure API_KEY with: openssl rand -hex 32
# - Keep API_KEY secret and rotate it periodically
# - Restrict database access to internal network only
# - Use HTTPS in production (configure reverse proxy)
# - API authentication protects admin/analytics endpoints
#
# =============================================================================
